<?xml version="1.0" encoding="utf-8"?>
<!--
  Hintergrund des Umschalters: das Foto von DuLo.
  Aus: helles Bild mit dunklem Schleier und grauem Rahmen (der Assistent läuft nicht).
  An: Foto in voller Helligkeit mit grünem Rahmen (der Assistent läuft).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <item>
                <bitmap
                    android:src="@drawable/dulo_hund"
                    android:gravity="fill" />
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="4dp"
                        android:color="#00E676" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <bitmap
                    android:src="@drawable/dulo_hund"
                    android:gravity="fill" />
            </item>
            <!-- Dunkler Schleier, solange der Assistent aus ist -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#A6000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="#555555" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
